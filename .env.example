# ---------------------------------------------------------------
# Copiá este archivo como .env y completá los valores.
#   cp .env.example .env
# ---------------------------------------------------------------

# Conexión a Postgres.
# Local con Docker:  postgresql://postgres:postgres@localhost:5433/soulcafe
#   (el docker-compose publica el 5433 para no chocar con un Postgres ya instalado)
# Neon / Supabase:   pegá aquí la cadena que te da el panel del proveedor.
DATABASE_URI=postgresql://postgres:postgres@localhost:5433/soulcafe

# Clave secreta de Payload. Generá una con:
#   openssl rand -base64 32
PAYLOAD_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria

# URL pública del sitio (sin barra final).
# En desarrollo: http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
